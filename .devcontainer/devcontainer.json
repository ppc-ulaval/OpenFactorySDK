{
    "image": "ghcr.io/openfactoryio/devcontainer",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "moby": false
        },
        "ghcr.io/openfactoryio/openfactory-sdk/infra:0.5.3": {},
        "ghcr.io/openfactoryio/openfactory-sdk/opcua-connector:0.5.3": {},
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": true,
            "configureZshAsDefaultShell": true
        }
    },
    "customizations": {
        "vscode": {
            "settings": {
                "python.languageServer": "None",
                "python.defaultInterpreterPath": "/workspaces/openfactory-sdk/lab-usine/.venv/bin/python",
                "ty.enable": true,
                "ty.disableLanguageServices": false,
                "ty.serverPath": "/workspaces/openfactory-sdk/lab-usine/.venv/bin/ty",
                "ruff.path": [
                    "/workspaces/openfactory-sdk/lab-usine/.venv/bin/ruff"
                ],
                "editor.formatOnSave": true
            },
            "extensions": [
                "astral-sh.ty",
                "charliermarsh.ruff"
            ]
        }
    },
    "containerEnv": {
        "ENVIRONMENT": "dev",
        "OPENFACTORY_VERSION": "v0.5.3",
        "OPENFACTORY_DOCKER_NETWORK": "factory-net",
        "OPENFACTORY_UNS_SCHEMA": "/workspaces/openfactory-sdk/lab-usine/uns.yml"
    }
}